<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Запись разговора с микрофона; спрашивается при первом нажатии «Записать». -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Запись продолжается, когда приложение свёрнуто или экран выключен. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Уведомление «Идёт запись»; спрашивается вместе с микрофоном, отказ запись не блокирует. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Перед загрузкой моделей: платная ли сеть, чтобы спросить про мобильный трафик. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Загрузка моделей продолжается, когда приложение свёрнуто. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Проигрывание расшифровки продолжается, когда приложение свёрнуто; управление с экрана блокировки. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <service
            android:name="dev.demo.nixyon.speech.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <service
            android:name="dev.demo.nixyon.speech.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <service
            android:name="dev.demo.nixyon.speech.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
