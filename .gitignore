# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Скачанные бинарники sherpa-onnx и модели не хранятся в git
/third_party/
/models/

# Модуль ключей словаря строит build.rs при каждой сборке приложения. В репозитории
# лежит готовая копия: её же создаёт preview/build_i18n.py, поэтому дизайн-превью и
# design-preview APK собираются без Rust. Остальное в папке — сборочный мусор.
/nixyon-app/ui/generated/*
!/nixyon-app/ui/generated/i18n.js

# Настройки IDE
/.idea/

# Локальный toolchain, браузерные профили проверки и промежуточные файлы APK
/.android-build/
/dist/*.idsig

# Локальные настройки скриптов (образец в config/example.env)
.env

# Видео и звук демонстрации не хранятся в git
/artifacts/demo/*.mp4
/artifacts/demo/*.mov
/artifacts/demo/*.mkv
/artifacts/demo/*.wav
