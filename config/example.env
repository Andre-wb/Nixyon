# Приложение на телефоне переменных окружения не читает. Эти переменные нужны только
# скриптам сборки и тестам на компьютере. Скопируйте в .env и экспортируйте перед запуском.

# Адрес зеркала моделей для scripts/fetch-models.sh; пустая строка выключает зеркало.
NIXYON_MODELS_MIRROR=https://nixyon.onyxar.org/models

# На сколько кусков делится большой файл при загрузке с зеркала, от 1 до 64.
NIXYON_FETCH_JOBS=16

# 1: scripts/fetch-models.sh качает ещё Sortformer fp32 (492 МБ) для замеров.
NIXYON_SORTFORMER_FP32=0

# Папка с models.json для тестов с моделями: cargo test -p nixyon-sherpa -- --ignored
MODELS_DIR=models

# true: APK собирается с видеокартой (Vulkan) для языковой модели.
# Перед сборкой нужен scripts/fetch-llama-cpp.sh --vulkan.
ORG_GRADLE_PROJECT_nixyonLlmVulkan=false
